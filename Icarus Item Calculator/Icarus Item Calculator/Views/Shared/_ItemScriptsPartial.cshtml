<script>
    $(document).ready(function () {
        const selectedRecipe = $('#selectedRecipe');
        const deleteRecipeButton = $('#deleteRecipeButton');
        const deleteRecipeId = $('#deleteRecipeId');

        // Show/hide quantity input for a single item
        function setIngredientVisibility(itemId, visible) {
            const qtyInput = $(`.quantity-input[data-item-id="${itemId}"]`);
            if (visible) {
                qtyInput.show();
            } else {
                qtyInput.hide();
                qtyInput.find('input').val(0);
            }
        }

        // Uncheck all ingredient checkboxes and hide all quantity inputs
        function clearAllIngredients() {
            $('.ingredient-checkbox').prop('checked', false);
            $('.quantity-input').hide().find('input').val(0);
        }

        // Load ingredients from the server for an existing recipe and check the right boxes
        function updateIngredients(recipeId) {
            clearAllIngredients();
            if (recipeId && recipeId !== 'new' && recipeId !== '') {
                $.getJSON(`/Home/GetRecipeIngredients?recipeId=${recipeId}`, function (data) {
                    data.forEach(function (ingredient) {
                        const checkbox = $(`#item_${ingredient.itemId}`);
                        checkbox.prop('checked', true);
                        const qtyInput = $(`.quantity-input[data-item-id="${ingredient.itemId}"] input`);
                        qtyInput.val(ingredient.quantity);
                        qtyInput.parent().show();
                    });
                }).fail(function (jqXHR, textStatus, errorThrown) {
                    console.error('Failed to load ingredients: ' + textStatus + ' - ' + errorThrown);
                });
            }
        }

        // When a checkbox changes, show/hide its quantity input
        // "No Recipe" (value=0) checkbox also unchecks everything else
        $(document).on('change', '.ingredient-checkbox', function () {
            const val = $(this).val();
            const checked = $(this).is(':checked');

            if (val === '0') {
                // "No Recipe" selected — uncheck all others
                if (checked) {
                    $('.ingredient-checkbox').not(this).prop('checked', false);
                    $('.quantity-input').hide().find('input').val(0);
                }
            } else {
                // Regular ingredient toggled — uncheck "No Recipe"
                if (checked) {
                    $('#item_0').prop('checked', false);
                }
                setIngredientVisibility(val, checked);
            }
        });

        // When recipe dropdown changes, reload ingredients and manage delete button
        selectedRecipe.change(function () {
            const recipeId = $(this).val();
            updateIngredients(recipeId);
            if (recipeId && recipeId !== 'new' && recipeId !== '') {
                deleteRecipeId.val(recipeId);
                deleteRecipeButton.prop('disabled', false);
            } else {
                deleteRecipeId.val('');
                deleteRecipeButton.prop('disabled', true);
            }
        });

        // Confirm deletion
        $('#deleteRecipeForm').submit(function (e) {
            if (!confirm('Are you sure you want to delete this recipe?')) {
                e.preventDefault();
            }
        });

        // On page load, pre-populate if a recipe is already selected
        const initialRecipeId = selectedRecipe.val();
        if (initialRecipeId) {
            updateIngredients(initialRecipeId);
            if (initialRecipeId !== 'new' && initialRecipeId !== '') {
                deleteRecipeId.val(initialRecipeId);
                deleteRecipeButton.prop('disabled', false);
            }
        }
    });
</script>
